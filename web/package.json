{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:setup": "bash setup-e2e.sh",
    "test:e2e:cache": "npx synpress e2e/wallet-setup --debug",
    "test:e2e:landing": "playwright test e2e/landing-page.spec.ts",
    "test:e2e:registration": "playwright test e2e/auto-registration.spec.ts",
    "test:e2e:admin": "playwright test e2e/admin-approval.spec.ts",
    "test:e2e:flow": "playwright test e2e/complete-supply-chain-flow.spec.ts",
    "test:e2e:flow:headed": "playwright test e2e/complete-supply-chain-flow.spec.ts --headed",
    "playwright:report": "playwright show-report",
    "playwright:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "ethers": "^6.15.0",
    "next": "15.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.56.1",
    "@synthetixio/synpress": "^4.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.2.2",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.6",
    "playwright-core": "^1.56.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

# ============ Foundry (Smart Contracts) ============

# Build artifacts
sc/out/
sc/cache/
sc/broadcast/

# Deployments (mantener solo .gitkeep)
sc/deployments/*.json
!sc/deployments/.gitkeep

# Dependencies
sc/lib/

# Foundry cache
sc/.forge-snapshots/

# Environment variables
sc/.env
sc/.env.local

# Node.js dependencies
sc/cache/
sc/lib/
sc/out/


# Dependencies
web/node_modules/
web/.pnp
web/.pnp.js

# Testing
web/coverage

# Next.js
web/.next/
web/out/
web/build

# Production
web/dist

# Debug
web/npm-debug.log*
web/yarn-debug.log*
web/yarn-error.log*

# Environment
web/.env
web/.env*.local

# Vercel
web/.vercel

# Typescript
web/*.tsbuildinfo
web/next-env.d.ts

